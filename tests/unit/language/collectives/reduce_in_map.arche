// `reduce` is legal inside a `map`: a per-element `reduce(+, <expr over Pool.col + this element>)` is the
// neighbour reduction / self-join — each element folds over the whole pool. A map holding a reduce runs as a
// scalar per-element loop (not the vectorized fusion). Here each row i gets (Σ B.px) * px_i = 6 * px_i.
// RUN: %arche build --pool-index=allow -o %t %s && %t | grep -qF "o=6 12 18"
#import { fmt }
B :: arche { px :: float, out :: float }
[3]B(3);

seed :: system {
  B.px = { 1.0, 2.0, 3.0 };
}

selfjoin :: map (query { px, out })(out) {
  s := reduce(+, B.px * px);
  out = s;
}

verify :: system eff {
  fmt.printf("o=%.0f %.0f %.0f\n", B.out[0], B.out[1], B.out[2]);
}

#run seq({ seed, selfjoin, verify })
