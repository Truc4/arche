// N-ary tuple groups: `(x, y)` is just the 2 case — `(x, y, z)`, `(a, b, c, d, e, f, g)`, … each mint N
// named sub-columns, with whole-column writes and indexed reads.
// RUN: %arche build --pool-index=allow -o %t %s && %t | grep -qF "t=1 3 5 g=7 a=1"
#import { fmt }
v3(x, y, z)             :: int;
v7(a, b, c, d, e, f, g) :: int;
P                       :: arche { v3 }
Q                       :: arche { v7 }
[2]P(2);
[1]Q(1);

seed :: system {
  P.v3.x = { 1, 2 };
  P.v3.y = { 3, 4 };
  P.v3.z = { 5, 6 };
  Q.v7.a = { 1 };
  Q.v7.g = { 7 };
}

show :: system eff {
  fmt.printf("t=%d %d %d g=%d a=%d\n", P.v3.x[0], P.v3.y[0], P.v3.z[0], Q.v7.g[0], Q.v7.a[0]);
}

#run seq({ seed, show })
