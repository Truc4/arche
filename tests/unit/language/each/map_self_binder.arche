// GAP (idiomatic-boids-gaps.md G6): the `as` self-binder is welded to `eff` — a PURE map can't bind itself
// (`as me`) to disambiguate self from an enclosing column. Binding self is not an effect. RED until decoupled.
// RUN: %arche build -o %t %s && %t | grep -qF "v=2 4 6"
#import { fmt }
x :: float;
P :: arche { x }
[3]P(3);

dbl :: map (query { x } as me) (x) {
  me.x = me.x * 2.0;
}

seed :: system { P.x = { 1.0, 2.0, 3.0 }; }

show :: system eff {
  fmt.printf("v=%.0f %.0f %.0f\n", P.x[0], P.x[1], P.x[2]);
}

#run seq({ seed, dbl, show })
