// `!abort` (the proc default here) writes a diagnostic to stderr before `_exit(134)` — a crash is
// not silent. Guards the bounds `abort` policy's `log_be_emit(LOG_ERR, "arche: index out of bounds\n", ..)`
// (the weak default in runtime/log.c routes it to stderr when no `log` backend is selected).
// RUN: %arche build -o %t %s && { %t 2>%t.err ; test $? -eq 134 ; } && grep -qF "arche: index out of bounds" %t.err
#import { os }
entry :: system eff {
  os.argc()(argc:);
  a: [4]int;
  a[0] = 1;
  i := argc + 100; // unprovable OOB -> default !abort
  x := a[i];
  y := x + 0;
}

#run entry
