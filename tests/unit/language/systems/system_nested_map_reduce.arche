// GAP (idiomatic-boids-gaps.md G7/G8): the honest self-join — a `system` querying whole COLUMNS wrapping a
// nested `map` querying per-element SCALARS, where the `reduce` folds the system's queried column. Today a
// columnar `system(query)` can't host a nested `map` (G7), and `reduce` can't fold a system's bound column
// (G8). Here each B row folds the whole `v` column, gated by its own `o`: o_i = (Σ v) * 1 = 6. RED until built.
// RUN: %arche build -o %t %s && %t | grep -qF "o=6 6 6"
#import { fmt }
v :: float;
o :: float;
B :: arche { v, o }
[3]B(3);

seed :: system { B.v = { 1.0, 2.0, 3.0 }; }

flock :: system (query { v }) {
  map (query { o } as me) (o) {
    me.o = reduce(+, v);
  }
}

show :: system eff {
  fmt.printf("o=%.0f %.0f %.0f\n", B.o[0], B.o[1], B.o[2]);
}

#run seq({ seed, flock, show })
