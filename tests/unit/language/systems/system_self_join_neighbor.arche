// The sound self-join: a `system (query {v} as Flock)` binds the whole neighbour column, a nested `map (query
// {v,o} as me)` binds this element. `me.v` is this row (self); `Flock.v` is the neighbour fold domain (the whole
// column). o_i = Σ_j (me.v_i − Flock.v_j) = N·v_i − Σv. v={10,20,30}, Σ=60, N=3 → o = -30, 0, 30. (If `me.v`
// collapsed into the folded `Flock.v`, every term is v_j−v_j=0 → o=0 0 0.)
// RUN: %arche build --pool-index=allow -o %t %s && %t | grep -qF "o=-30 0 30"
#import { fmt }
v :: float;
o :: float;
B :: arche { v, o }
[3]B(3);

seed :: system {
  B.v = { 10.0, 20.0, 30.0 };
}

flock :: system (query { v } as Flock) {
  map (query { v, o } as me)(o) {
    me.o = reduce(+, me.v - Flock.v);
  };
}

show :: system eff {
  fmt.printf("o=%.0f %.0f %.0f\n", B.o[0], B.o[1], B.o[2]);
}

#run seq({ seed, flock, show })
