// The boids' cohesion/separation shape: a TUPLE-valued reduce over the enclosing system's bound tuple column.
// Each row's o = Σ_j pos_j (sum of ALL positions, a 2-vector). pos = {(1,2),(3,4),(5,6)}; Σ = (9,12). Every
// row folds the whole `pos` column (me is unused here — pure sum), so o = (9,12) for all. Exercises: a tuple
// group column as the fold domain + a tuple-accumulating reduce.
// RUN: %arche build -o %t %s && %t | grep -qF "o=9 12 9 12 9 12"
#import { fmt }
pos(x, y) :: float;
o(x, y)   :: float;
B         :: arche { pos, o }
[3]B(3);

seed :: system {
  B.pos.x = { 1.0, 3.0, 5.0 };
  B.pos.y = { 2.0, 4.0, 6.0 };
}

flock :: system (query { pos }) {
  map (query { o } as me)(o) {
    me.o = reduce(+, pos);
  };
}

show :: system eff {
  fmt.printf(
    "o=%.0f %.0f %.0f %.0f %.0f %.0f\n",
    B.o.x[0],
    B.o.y[0],
    B.o.x[1],
    B.o.y[1],
    B.o.x[2],
    B.o.y[2],
  );
}

#run seq({ seed, flock, show })
