// `_` in an in-out in-slot denotes the out-binding's place — no value is passed there and no copy
// happens; it makes explicit that the in-position is shadowed by the out-param. The in-out idiom is a
// `#foreign` (C-ABI) feature: libc `memset` fills the buffer in place through one pointer and returns it,
// so the call names `b` only in the out-list with `_` standing in for it on the in-side. Prints "XX" if
// `_` correctly resolved to `b` (memset wrote it).
// RUN: %arche build -o %t %s ; %t | grep -q "^XX$"
#import { fmt }
#foreign {
  memset :: proc(s: []char, c: int, n: i64)(s: []char);
}
entry :: system eff {
  b: [3]char;
  memset(_, 88, 2)(b); // fill 2 bytes with 88 ('X'); `_` is the in-slot for the out-bound `b`
  b[2] = 0;            // null-terminate for print
  fmt.print(b)(_:);
}

#run entry
