// A `@gpu` map with an `if` — the GLSL emitter lowers it to a native `if (…) { … } else { … }`, so a simple
// branchy map runs on the GPU (not just CPU). CPU path (scalar per-element) must match; `make test-gpu-exe`
// runs it on the device. Sign of each value.
// RUN: %arche build -o %t %s && %t | grep -qF "x=1 0 1 0"
#import { fmt }
x :: float;
P :: arche { x }
[4]P(4);

@gpu

sign :: map (query { x }) (x) {
  if (x > 0.0) {
    x = 1.0;
  } else {
    x = 0.0;
  }
}

seed :: system { P.x = { 5.0, -2.0, 7.0, -1.0 }; }

verify :: system eff { fmt.printf("x=%.0f %.0f %.0f %.0f\n", P.x[0], P.x[1], P.x[2], P.x[3]); }

#run seq({ seed, sign, verify })
