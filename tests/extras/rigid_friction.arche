// Driver test for the Coulomb FRICTION impulse, ITERATED to convergence. A box is driven into a static floor
// moving right AND down (lvel=(4,−10)). The normal impulse arrests the fall (vy→0); the tangential (friction)
// impulse, clamped each iteration to the Coulomb cone μ·|Jn| (μ=0.3), opposes the sideways motion, so over
// the iterations vx bleeds down from 4 toward ~1 (it does NOT reach exactly 0 — the per-iteration cone limit
// caps how fast tangential speed can shed). A frictionless run would leave vx=4 unchanged, so vx<3 proves
// friction acted. The centred contact keeps spin near zero.
// RUN: %arche build --pool-index=allow -o %t %s && %t | grep -qxF "ok"
#import { rigid vec fmt os }

c :: float;
Clock :: arche { c }

[4]RBody(2);
[1]Clock(1);
seed :: system {
  RBody.pos.x  = { 0.0,  0.0    };  RBody.pos.y  = { 0.9,  -100.0 };
  RBody.lvel.x = { 4.0,  0.0    };  RBody.lvel.y = { -10.0, 0.0   };
  RBody.spin.x = { 0.0,  0.0    };  RBody.spin.y = { 0.0,  0.0    };
  RBody.rot.x  = { 1.0,  1.0    };  RBody.rot.y  = { 0.0,  0.0    };
  RBody.ext.x  = { 1.0,  1000.0 };  RBody.ext.y  = { 1.0,  100.0  };
  RBody.mi.x   = { 1.0,  0.0    };  RBody.mi.y   = { 1.0,  0.0    };
  RBody.mat.x  = { 0.0,  0.0    };  RBody.mat.y  = { 0.3,  0.3    };
  RBody.dimp.x = { 0.0,  0.0    };  RBody.dimp.y = { 0.0,  0.0    };
  RBody.dang.x = { 0.0,  0.0    };  RBody.dang.y = { 0.0,  0.0    };
  RBody.cor.x  = { 0.0,  0.0    };  RBody.cor.y  = { 0.0,  0.0    };
  Clock.c = { 0.0 };
}

tick :: map (query { c })(c) { c = c + 1.0; }

// forever ⇒ trio inlined once, frame N == iteration N. Check after friction has converged.
check :: system eff {
  map (query { c }) eff {
    if (c > 39.5) {
      fmt.assert(RBody.lvel.x[0] > 0.6 && RBody.lvel.x[0] < 1.5, "friction should cut vx from 4 toward ~1\n")();
      fmt.assert(RBody.lvel.y[0] > -0.2 && RBody.lvel.y[0] < 0.2, "normal impulse should stop the fall\n")();
      fmt.assert(RBody.spin.x[0] > -0.3 && RBody.spin.x[0] < 0.3, "centred contact ⇒ little spin\n")();
      fmt.printf("ok\n");
      fmt.fflush(0)(_:);
      os.exit(0)(_:);
    }
  };
}

#run seq({ seed, forever(seq({ rigid.solve_lin, rigid.solve_ang, rigid.apply, tick, check })) })
