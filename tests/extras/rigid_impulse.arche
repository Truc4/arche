// Driver test for the impulse solver (`rigid.solve_lin` + `rigid.solve_ang` + `rigid.apply`), ITERATED to
// convergence. A dynamic unit box penetrating a static floor, closing at vy=−5, is resolved by repeating the
// solve trio. The solver is Jacobi + under-relaxed (RELAX<1) and restitution-suppressed (a resting contact
// below REST_SLOP closing speed gets e=0), so the CONVERGED state is a dead-stop resting contact — the
// normal velocity is driven to ≈0 (NOT a +e bounce: bounce is intentionally damped so stacks don't buzz).
// The contact is laterally centred, so the two manifold points give equal-and-opposite torques ⇒ no spin,
// and straight-down motion has no tangential component ⇒ no sideways drift.
// RUN: %arche build --pool-index=allow -o %t %s && %t | grep -qxF "ok"
#import { rigid vec fmt os }

c :: float;
Clock :: arche { c }

[4]RBody(2);
[1]Clock(1);
seed :: system {
  RBody.pos.x  = { 0.0,  0.0    };  RBody.pos.y  = { 0.9,  -100.0 };
  RBody.lvel.x = { 0.0,  0.0    };  RBody.lvel.y = { -5.0, 0.0    };
  RBody.spin.x = { 0.0,  0.0    };  RBody.spin.y = { 0.0,  0.0    };
  RBody.rot.x  = { 1.0,  1.0    };  RBody.rot.y  = { 0.0,  0.0    };
  RBody.ext.x  = { 1.0,  1000.0 };  RBody.ext.y  = { 1.0,  100.0  };
  RBody.mi.x   = { 1.0,  0.0    };  RBody.mi.y   = { 1.0,  0.0    };
  RBody.mat.x  = { 0.2,  0.2    };  RBody.mat.y  = { 0.0,  0.0    };
  RBody.dimp.x = { 0.0,  0.0    };  RBody.dimp.y = { 0.0,  0.0    };
  RBody.dang.x = { 0.0,  0.0    };  RBody.dang.y = { 0.0,  0.0    };
  RBody.cor.x  = { 0.0,  0.0    };  RBody.cor.y  = { 0.0,  0.0    };
  Clock.c = { 0.0 };
}

tick :: map (query { c })(c) { c = c + 1.0; }

// forever loop so the solve trio is inlined ONCE (a per-frame unroll of many iterations overflows llc); the
// loop re-runs it each frame, so frame N == iteration N of the velocity solve. Check after it has converged.
check :: system eff {
  map (query { c }) eff {
    if (c > 39.5) {
      fmt.assert(RBody.lvel.y[0] > -0.2 && RBody.lvel.y[0] < 0.2, "closing velocity should resolve to rest (~0)\n")();
      fmt.assert(RBody.lvel.x[0] > -0.01 && RBody.lvel.x[0] < 0.01, "no sideways drift expected\n")();
      fmt.assert(RBody.spin.x[0] > -0.01 && RBody.spin.x[0] < 0.01, "centred contact should give no spin\n")();
      fmt.assert(RBody.lvel.y[1] > -0.01 && RBody.lvel.y[1] < 0.01, "static floor must not move\n")();
      fmt.printf("ok\n");
      fmt.fflush(0)(_:);
      os.exit(0)(_:);
    }
  };
}

#run seq({ seed, forever(seq({ rigid.solve_lin, rigid.solve_ang, rigid.apply, tick, check })) })
