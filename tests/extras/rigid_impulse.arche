// Driver test for the soft-constraint NORMAL impulse under a hard impact: a box free-falls from a height and
// hits a wide static floor at high speed (~17 px/frame). The substepped solver must ARREST it at the surface
// (pos.y ≈ 40, ext.y) with essentially zero penetration and WITHOUT tunnelling through the floor, no spurious
// spin, then hold it at rest. 16 TGS substeps/frame (see rigid_settle for the schedule shape).
// RUN: %arche build --pool-index=allow -o %t %s && %t | grep -qxF "ok"
#import { rigid vec fmt os }

GDT   :: 0.025; // GRAV(0.4) * DT(1/16)
c     :: float;
Clock :: arche { c }

[4]RBody(2);
[1]Clock(1);
seed :: system {
  RBody.pos.x  = { 0.0, 0.0 };
  RBody.pos.y  = { 500.0, -1000.0 };
  RBody.lvel.x = { 0.0, 0.0 };
  RBody.lvel.y = { 0.0, 0.0 };
  RBody.spin.x = { 0.0, 0.0 };
  RBody.spin.y = { 0.0, 0.0 };
  RBody.rot.x  = { 1.0, 1.0 };
  RBody.rot.y  = { 0.0, 0.0 };
  RBody.ext.x  = { 40.0, 4000.0 };
  RBody.ext.y  = { 40.0, 1000.0 };
  RBody.mi.x   = { 1.0, 0.0 };
  RBody.mi.y   = { 0.0009375, 0.0 };
  RBody.mat.x  = { 0.0, 0.0 };
  RBody.mat.y  = { 0.0, 0.0 };
  RBody.dimp.x = { 0.0, 0.0 };
  RBody.dimp.y = { 0.0, 0.0 };
  RBody.dang.x = { 0.0, 0.0 };
  RBody.dang.y = { 0.0, 0.0 };
  RBody.cor.x  = { 0.0, 0.0 };
  RBody.cor.y  = { 0.0, 0.0 };
  Clock.c      = { 0.0 };
}

grav :: map (query { lvel, mi })(lvel) {
  lvel.y = lvel.y - GDT * select(mi.x > 0.0, 1.0, 0.0);
}
tick :: map (query { c })(c) {
  c = c + 1.0;
}

sub :: func() -> Schedule {
  return seq(
    {
      grav,
      rigid.contacts,
      rigid.solve_lin,
      rigid.solve_ang,
      rigid.apply,
      rigid.solve_lin,
      rigid.solve_ang,
      rigid.apply,
      rigid.integrate,
      rigid.solve_lin_relax,
      rigid.solve_ang_relax,
      rigid.apply,
    },
  );
}

check :: system eff {
  map (query { c }) eff {
    if (c > 119.5) {
      fmt.assert(
        RBody.pos.y[0] > 39.5 && RBody.pos.y[0] < 40.2,
        "high-speed impact must arrest at the surface (~40), no tunnel\n",
      )();
      fmt.assert(RBody.lvel.y[0] > -0.05 && RBody.lvel.y[0] < 0.05, "must settle to rest\n")();
      fmt.assert(
        RBody.spin.x[0] > -0.02 && RBody.spin.x[0] < 0.02,
        "centred impact ⇒ no spin\n",
      )();
      fmt.printf("ok\n");
      fmt.fflush(0)(_:);
      os.exit(0)(_:);
    }
  };
}

#run seq(
  {
    seed,
    forever(
      seq(
        {
          sub(),
          sub(),
          sub(),
          sub(),
          sub(),
          sub(),
          sub(),
          sub(),
          sub(),
          sub(),
          sub(),
          sub(),
          sub(),
          sub(),
          sub(),
          sub(),
          tick,
          check,
        },
      ),
    ),
  },
)
