// Driver test for the impulse solver (`rigid.solve_lin` + `rigid.solve_ang` + `rigid.apply`): a dynamic
// unit box falls straight onto a static floor and BOUNCES with restitution, without spurious spin.
// Box@(0,0.9) ext(1,1) mi=(1,1) lvel=(0,-5); floor@(0,-100) ext(1000,100) mi=(0,0) static; restitution 0.2
// both. One solve+apply: the normal impulse reverses the closing speed by (1+e): vy −5 → +1.0 (= e·5).
// Contact is laterally centred so no angular impulse (spin.x≈0), and the straight-down motion has no
// tangential component so friction stays 0 (vx≈0).
// RUN: %arche build --pool-index=allow -o %t %s && %t | grep -qxF "ok"
#import { rigid vec fmt }

[4]RBody(2);
seed :: system {
  RBody.pos.x  = { 0.0,  0.0    };  RBody.pos.y  = { 0.9,  -100.0 };
  RBody.lvel.x = { 0.0,  0.0    };  RBody.lvel.y = { -5.0, 0.0    };
  RBody.spin.x = { 0.0,  0.0    };  RBody.spin.y = { 0.0,  0.0    };
  RBody.rot.x  = { 1.0,  1.0    };  RBody.rot.y  = { 0.0,  0.0    };
  RBody.ext.x  = { 1.0,  1000.0 };  RBody.ext.y  = { 1.0,  100.0  };
  RBody.mi.x   = { 1.0,  0.0    };  RBody.mi.y   = { 1.0,  0.0    };
  RBody.mat.x  = { 0.2,  0.2    };  RBody.mat.y  = { 0.0,  0.0    };
  RBody.dimp.x = { 0.0,  0.0    };  RBody.dimp.y = { 0.0,  0.0    };
  RBody.dang.x = { 0.0,  0.0    };  RBody.dang.y = { 0.0,  0.0    };
  RBody.cor.x  = { 0.0,  0.0    };  RBody.cor.y  = { 0.0,  0.0    };
}

verify :: system eff {
  // body 0 is the falling box; comparisons on indexed reads are fine (avoid `:= then arithmetic`)
  fmt.assert(RBody.lvel.y[0] > 0.99 && RBody.lvel.y[0] < 1.01, "restitution bounce should give vy=+1\n")();
  fmt.assert(RBody.lvel.x[0] > -0.01 && RBody.lvel.x[0] < 0.01, "no sideways drift expected\n")();
  fmt.assert(RBody.spin.x[0] > -0.01 && RBody.spin.x[0] < 0.01, "centred contact should give no spin\n")();
  fmt.assert(RBody.lvel.y[1] > -0.01 && RBody.lvel.y[1] < 0.01, "static floor must not move\n")();
  fmt.printf("ok\n");
}

#run seq({ seed, rigid.solve_lin, rigid.solve_ang, rigid.apply, verify })
