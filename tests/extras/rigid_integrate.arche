// Driver test for `rigid.integrate`: a rigid body translates by its linear velocity and its orientation
// unit-vector `rot` spins by `avel` while STAYING unit length (renormalised small-angle step — no trig).
// Body starts pos=(10,20), mo=(3,-1,0.2) [lvel=(3,-1), avel=0.2], rot=(1,0). After 5 frames pos=(25,15)
// exactly; rot has turned ~1.0 rad CCW (rot.y climbs) and |rot| is still 1.
// RUN: %arche build --pool-index=allow -o %t %s && %t | grep -qxF "ok"
#import { rigid vec fmt }

[4]RBody(1);
seed :: system {
  RBody.pos.x  = { 10.0 };  RBody.pos.y  = { 20.0 };
  RBody.lvel.x = { 3.0 };   RBody.lvel.y = { -1.0 };
  RBody.spin.x = { 0.2 };   RBody.spin.y = { 0.0 };
  RBody.rot.x  = { 1.0 };   RBody.rot.y  = { 0.0 };
  RBody.ext.x  = { 1.0 };   RBody.ext.y  = { 1.0 };
  RBody.mi.x   = { 1.0 };   RBody.mi.y   = { 1.0 };
  RBody.mat.x  = { 0.0 };   RBody.mat.y  = { 0.0 };
  RBody.dimp.x = { 0.0 };   RBody.dimp.y = { 0.0 };
  RBody.dang.x = { 0.0 };   RBody.dang.y = { 0.0 };
  RBody.cor.x  = { 0.0 };   RBody.cor.y  = { 0.0 };
}

// Assertions read state via column comparisons + a func (vec.len), NOT `local := RBody.vec.x[0]; local*…`.
verify :: system eff {
  len := vec.len(vec.mk(RBody.rot.x[0], RBody.rot.y[0]));
  fmt.assert(RBody.pos.x[0] == 25.0 && RBody.pos.y[0] == 15.0, "linear integrate wrong\n")();
  fmt.assert(len > 0.999 && len < 1.001, "rot drifted off unit length\n")();
  fmt.assert(RBody.rot.y[0] > 0.5 && RBody.rot.x[0] < 0.9 && RBody.rot.x[0] > 0.0, "rot did not spin CCW\n")();
  fmt.printf("ok\n");
}

#run seq({ seed, integrate, integrate, integrate, integrate, integrate, verify })
