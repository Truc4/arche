// Driver test: a STACK of 3 unit boxes dropped onto a static floor settles into a stable tower — the
// hardest case for a rigid solver. Each frame runs the velocity solve twice and the positional
// de-penetration six times (Jacobi needs iterations to propagate separation up a stack), all inside a
// `forever` loop (inlined once — small IR). After 200 frames the three boxes rest at y≈1, 3, 5 (each 2
// tall, stacked, bottoms touching), upright (no spin), neither compressed into each other nor exploded.
// This is the M5 stacking goal met by iteration on the single-point contact (a clipped 2-point manifold
// would let it converge in fewer iterations).
// RUN: %arche build --pool-index=allow -o %t %s && %t | grep -qxF "ok"
#import { rigid vec fmt os }

G :: 0.03;
c :: float;
Clock :: arche { c }

[8]RBody(4);
[1]Clock(1);
seed :: system {
  RBody.pos.x  = { 0.0,    0.0, 0.0, 0.0 };  RBody.pos.y  = { -100.0, 1.2, 3.5, 5.8 };
  RBody.lvel.x = { 0.0,    0.0, 0.0, 0.0 };  RBody.lvel.y = { 0.0, 0.0, 0.0, 0.0 };
  RBody.spin.x = { 0.0,    0.0, 0.0, 0.0 };  RBody.spin.y = { 0.0, 0.0, 0.0, 0.0 };
  RBody.rot.x  = { 1.0,    1.0, 1.0, 1.0 };  RBody.rot.y  = { 0.0, 0.0, 0.0, 0.0 };
  RBody.ext.x  = { 1000.0, 1.0, 1.0, 1.0 };  RBody.ext.y  = { 100.0, 1.0, 1.0, 1.0 };
  RBody.mi.x   = { 0.0,    1.0, 1.0, 1.0 };  RBody.mi.y   = { 0.0, 1.0, 1.0, 1.0 };
  RBody.mat.x  = { 0.0,    0.0, 0.0, 0.0 };  RBody.mat.y  = { 0.4, 0.4, 0.4, 0.4 };
  RBody.dimp.x = { 0.0,0.0,0.0,0.0 };  RBody.dimp.y = { 0.0,0.0,0.0,0.0 };
  RBody.dang.x = { 0.0,0.0,0.0,0.0 };  RBody.dang.y = { 0.0,0.0,0.0,0.0 };
  RBody.cor.x  = { 0.0,0.0,0.0,0.0 };  RBody.cor.y  = { 0.0,0.0,0.0,0.0 };
  Clock.c = { 0.0 };
}

grav :: map (query { lvel, mi })(lvel) { lvel.y = lvel.y - G * select(mi.x > 0.0, 1.0, 0.0); }
tick :: map (query { c })(c) { c = c + 1.0; }

check :: system eff {
  map (query { c }) eff {
    if (c > 199.5) {
      fmt.assert(RBody.pos.y[1] > 0.85 && RBody.pos.y[1] < 1.15, "bottom box should rest at ~1\n")();
      fmt.assert(RBody.pos.y[2] > 2.7  && RBody.pos.y[2] < 3.15, "middle box should rest at ~3\n")();
      fmt.assert(RBody.pos.y[3] > 4.55 && RBody.pos.y[3] < 5.1,  "top box should rest at ~5\n")();
      fmt.assert(RBody.spin.x[1] > -0.05 && RBody.spin.x[1] < 0.05, "boxes should stay upright\n")();
      fmt.assert(RBody.spin.x[3] > -0.05 && RBody.spin.x[3] < 0.05, "top box should stay upright\n")();
      fmt.printf("ok\n");
      fmt.fflush(0)(_:);
      os.exit(0)(_:);
    }
  };
}

#run seq({ seed, forever(seq({ grav, integrate,
        rigid.solve_lin, rigid.solve_ang, rigid.apply, rigid.solve_lin, rigid.solve_ang, rigid.apply,
        rigid.solve_pos, rigid.apply_pos, rigid.solve_pos, rigid.apply_pos, rigid.solve_pos, rigid.apply_pos,
        rigid.solve_pos, rigid.apply_pos, rigid.solve_pos, rigid.apply_pos, rigid.solve_pos, rigid.apply_pos,
        tick, check })) })
