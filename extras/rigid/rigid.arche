/// Behavior for the `rigid` device — 2D rigid-body dynamics with ROTATION over oriented boxes (OBBs):
/// SAT collision detection, a contact point, and an impulse solver with restitution + friction + angular
/// response, plus a positional de-penetration pass. The full-fat companion to the AABB `physics` device.
///
/// Unlike `physics` (a single branch-free `select` kernel), a rigid solver needs real vector algebra, so
/// the geometry lives in pure value `func`s (rotate/cross/SAT/contact/impulse) and the per-frame work is
/// the boids self-join `reduce`: each body folds the pairwise impulses from every other body into an
/// accumulator (a velocity SNAPSHOT read), then a second pass applies it — Jacobi, data-parallel,
/// order-independent. The impulse response is split into a LINEAR and an ANGULAR reduce (`solve_lin` /
/// `solve_ang`) because each fold is a 2-vector (the impulse is 3 numbers); both read the same pre-`apply`
/// snapshot. Iterate by listing the trio several times in the schedule. Orientation is a unit vector (no
/// trig): a body is spun by renormalising `rot + perp(rot)·ω`.
///
/// Per-body scalars are packed into 2-vector `x` (`spin`/`mi`/`mat`/`dang`) — see the datasheet for why.
/// Systems are device-qualified in a driver's schedule (`rigid.solve_lin`, …), like the `physics` device.
#import { vec }

/// An oriented rigid body. `lvel`=linear vel, `spin.x`=angular vel, `rot`=orientation unit-vec,
/// `ext`=half-extents, `mi`=(invMass,invInertia), `mat`=(restitution,friction), `dimp`/`dang`/`cor`=solver
/// accumulators. Seed `rot=(1,0)` for angle 0 and `mi=(0,0)` for a static body.
RBody :: arche { pos, lvel, spin, rot, ext, mi, mat, dimp, dang, cor }

// --- vector helpers (pure, branch-free) --------------------------------------

/// Rotate a local-frame vector `v` into world by the orientation unit-vector `r` — a complex multiply.
rotate :: func(v: pos, r: pos) -> pos {
  return (v.x * r.x - v.y * r.y, v.x * r.y + v.y * r.x);
}

/// Left perpendicular (90° CCW): `(x, y) -> (-y, x)`.
perp :: func(v: pos) -> pos {
  return (0.0 - v.y, v.x);
}

/// 2D scalar cross product `a × b = ax·by − ay·bx` — the lever-arm term.
cross :: func(a: pos, b: pos) -> float {
  return a.x * b.y - a.y * b.x;
}

/// Angular-velocity (scalar) crossed with a radius vector: `ω × r = (−ω·ry, ω·rx)`.
crossw :: func(w: float, r: pos) -> pos {
  return (0.0 - w * r.y, w * r.x);
}

/// Normalise to unit length.
normalize :: func(v: pos) -> pos {
  l := sqrt(v.x * v.x + v.y * v.y);
  return v * (1.0 / l);
}

/// Component-wise vector select (`select` does not lower on whole-vector operands): `c==1 ? a : b`.
vsel :: func(c: int, a: pos, b: pos) -> pos {
  return vec.mk(select(c == 1, a.x, b.x), select(c == 1, a.y, b.y));
}

// --- collision detection (separating-axis test over oriented boxes) ----------

/// Half-width of an OBB projected onto a unit axis `n`, given its world axes `ax`/`ay` and half-extents.
obb_radius :: func(ax: pos, ay: pos, ext: pos, n: pos) -> float {
  return ext.x * vec.absf(vec.dot(ax, n)) + ext.y * vec.absf(vec.dot(ay, n));
}

/// Signed overlap of boxes A and B along unit axis `n`: `(radiusA + radiusB) − |(cB−cA)·n|`. >0 overlap.
axis_overlap :: func(n: pos, pa: pos, axa: pos, aya: pos, ea: pos, pb: pos, axb: pos, ayb: pos, eb: pos) -> float {
  ra := obb_radius(axa, aya, ea, n);
  rb := obb_radius(axb, ayb, eb, n);
  return ra + rb - vec.absf(vec.dot(pb - pa, n));
}

/// The 2D separating-axis test between two OBBs. Returns `(normal.x, normal.y, penetration)` as a `pos3`:
/// the normal is the least-overlap axis (MTV direction), signed A→B; `penetration < 0` ⇒ disjoint.
sat :: func(pa: pos, ra: pos, ea: pos, pb: pos, rb: pos, eb: pos) -> pos3 {
  axa := ra;  aya := perp(ra);
  axb := rb;  ayb := perp(rb);
  o0 := axis_overlap(axa, pa, axa, aya, ea, pb, axb, ayb, eb);
  o1 := axis_overlap(aya, pa, axa, aya, ea, pb, axb, ayb, eb);
  o2 := axis_overlap(axb, pa, axa, aya, ea, pb, axb, ayb, eb);
  o3 := axis_overlap(ayb, pa, axa, aya, ea, pb, axb, ayb, eb);
  bx := axa.x;  by := axa.y;  bo := o0;
  c1 := o1 < bo;  bx = select(c1, aya.x, bx);  by = select(c1, aya.y, by);  bo = select(c1, o1, bo);
  c2 := o2 < bo;  bx = select(c2, axb.x, bx);  by = select(c2, axb.y, by);  bo = select(c2, o2, bo);
  c3 := o3 < bo;  bx = select(c3, ayb.x, bx);  by = select(c3, ayb.y, by);  bo = select(c3, o3, bo);
  nrm  := vec.mk(bx, by);
  flip := vec.dot(pb - pa, nrm) < 0.0;
  sx := select(flip, 0.0 - bx, bx);
  sy := select(flip, 0.0 - by, by);
  return (sx, sy, bo);
}

// --- contact resolution (impulse solver with restitution + friction + spin) --

/// One contact's impulse response ON body A, at contact point `c` with normal `n` (A→B): a NORMAL impulse
/// (restitution `e` + the rotational effective mass) plus a Coulomb-cone-clamped FRICTION impulse (`mu`),
/// from the relative velocity at `c` INCLUDING spin, scaled by `w` (the caller passes 1/activeContacts so
/// the two manifold points share the load). Returns A's (Δlvel.x, Δlvel.y, Δω). `hit` gates it to an
/// overlapping, approaching contact.
contact_impulse :: func(c: pos, n: pos, e: float, mu: float, hit: float, w: float,
                        pa: pos, lva: pos, wa: float, ma: mi,
                        pb: pos, lvb: pos, wb: float, mb: mi) -> pos3 {
  rA := c - pa;  rB := c - pb;
  vA := lva + crossw(wa, rA);
  vB := lvb + crossw(wb, rB);
  vrel := vB - vA;
  vn  := vec.dot(vrel, n);
  rnA := cross(rA, n);  rnB := cross(rB, n);
  kn0 := ma.x + mb.x + ma.y * rnA * rnA + mb.y * rnB * rnB;
  kn  := select(kn0 > 0.0, kn0, 1.0);            // guard the divide (static–static / self pair)
  closing := select(vn < 0.0, 1.0, 0.0);
  jn  := (0.0 - (1.0 + e)) * vn / kn * hit * closing;
  t   := perp(n);
  vt  := vec.dot(vrel, t);
  rtA := cross(rA, t);  rtB := cross(rB, t);
  kt0 := ma.x + mb.x + ma.y * rtA * rtA + mb.y * rtB * rtB;
  kt  := select(kt0 > 0.0, kt0, 1.0);
  jt0 := (0.0 - vt) / kt * hit;
  lim := mu * vec.absf(jn);
  jt  := select(jt0 > lim, lim, select(jt0 < 0.0 - lim, 0.0 - lim, jt0));
  p   := (n * jn + t * jt) * w;                  // share of the load
  dl  := p * (0.0 - ma.x);
  dw  := (0.0 - ma.y) * cross(rA, p);
  return (dl.x, dl.y, dw);
}

/// The velocity change body A receives from its contact with B — a TWO-POINT manifold, which is what lets a
/// box rest FLAT and stack (two touching corners give opposing torques that cancel spin; a single point
/// would tip it). The manifold is the INCIDENT box's face vertices: SAT gives the normal and the REFERENCE
/// box (the one the normal is a face of); the incident box's face toward it has two vertices, and EACH is a
/// contact only if it actually penetrates the reference face (below it, within its tangential span). So a
/// box flat on the floor has BOTH corners in contact (rests flat), while a box tipped on one corner has
/// only that corner (it topples). Returns A's (Δlvel.x, Δlvel.y, Δω); the load is split 1/activeContacts.
pair_response :: func(pa: pos, ra: pos, ea: pos, lva: pos, sa: spin, ma: mi, ta: mat,
                      pb: pos, rb: pos, eb: pos, lvb: pos, sb: spin, mb: mi, tb: mat) -> pos3 {
  e  := select(ta.x < tb.x, tb.x, ta.x);   // restitution = max of the pair
  mu := select(ta.y < tb.y, ta.y, tb.y);   // friction    = min of the pair
  st  := sat(pa, ra, ea, pb, rb, eb);
  n   := vec.mk(st.x, st.y);
  sep := pb - pa;
  far := select(sep.x * sep.x + sep.y * sep.y > 0.0001, 1.0, 0.0);   // 0 for a self/coincident pair
  hit := select(st.z > 0.0, far, 0.0);
  axa := ra;  aya := perp(ra);
  axb := rb;  ayb := perp(rb);
  // REFERENCE = the box whose face the SAT normal is (n is exactly one box's axis). INCIDENT = the other.
  aref := select(vec.absf(vec.dot(n, axa)) > 0.99, 1, select(vec.absf(vec.dot(n, aya)) > 0.99, 1, 0));
  rn  := vsel(aref, n, vec.mk(0.0 - n.x, 0.0 - n.y));   // reference → incident direction
  ip  := vsel(aref, pb, pa);                             // incident box
  iax := vsel(aref, axb, axa);
  iay := vsel(aref, ayb, aya);
  iex := select(aref == 1, eb.x, ea.x);
  iey := select(aref == 1, eb.y, ea.y);
  rp  := vsel(aref, pa, pb);                             // reference box
  rax := vsel(aref, axa, axb);
  ray := vsel(aref, aya, ayb);
  rex := select(aref == 1, ea.x, eb.x);
  rey := select(aref == 1, ea.y, eb.y);
  rext := vec.mk(rex, rey);
  // incident FACE = perpendicular to whichever incident axis lies most along rn; its two vertices:
  dax := vec.dot(iax, rn);  day := vec.dot(iay, rn);
  useX := select(vec.absf(dax) >= vec.absf(day), 1, 0);
  faceAxis := vsel(useX, iax, iay);
  faceExt  := select(useX == 1, iex, iey);
  perpAxis := vsel(useX, iay, iax);
  perpExt  := select(useX == 1, iey, iex);
  dsel := select(useX == 1, dax, day);
  sn := select(dsel > 0.0, 0.0 - 1.0, 1.0);              // face on the side opposing rn
  fc := ip + faceAxis * (sn * faceExt);
  v1 := fc + perpAxis * perpExt;
  v2 := fc - perpAxis * perpExt;
  // reference surface + tangential span (a vertex is a contact only if past the surface AND over the face)
  sref := vec.dot(rp, rn) + obb_radius(rax, ray, rext, rn);
  tr := perp(rn);
  rc := vec.dot(rp, tr);  rr := obb_radius(rax, ray, rext, tr);
  pen1 := sref - vec.dot(v1, rn);   t1 := vec.dot(v1, tr);
  pen2 := sref - vec.dot(v2, rn);   t2 := vec.dot(v2, tr);
  hit1 := hit * select(pen1 > 0.0 && t1 > rc - rr && t1 < rc + rr, 1.0, 0.0);
  hit2 := hit * select(pen2 > 0.0 && t2 > rc - rr && t2 < rc + rr, 1.0, 0.0);
  cnt := hit1 + hit2;
  w   := select(cnt > 0.5, 1.0 / cnt, 0.0);              // split the load across the active contacts
  r1  := contact_impulse(v1, n, e, mu, hit1, w, pa, lva, sa.x, ma, pb, lvb, sb.x, mb);
  r2  := contact_impulse(v2, n, e, mu, hit2, w, pa, lva, sa.x, ma, pb, lvb, sb.x, mb);
  return (r1.x + r2.x, r1.y + r2.y, r1.z + r2.z);
}

/// Linear velocity change body A receives from B — the (Δlvel) half of the 2-point response. Folded over B.
imp_lin :: func(pa: pos, ra: pos, ea: pos, lva: pos, sa: spin, ma: mi, ta: mat,
                pb: pos, rb: pos, eb: pos, lvb: pos, sb: spin, mb: mi, tb: mat) -> pos {
  r := pair_response(pa, ra, ea, lva, sa, ma, ta, pb, rb, eb, lvb, sb, mb, tb);
  return vec.mk(r.x, r.y);
}

/// Angular velocity change body A receives from B — the (Δω) half, packed as a `spin` for the 2-vec reduce.
imp_ang :: func(pa: pos, ra: pos, ea: pos, lva: pos, sa: spin, ma: mi, ta: mat,
                pb: pos, rb: pos, eb: pos, lvb: pos, sb: spin, mb: mi, tb: mat) -> spin {
  r := pair_response(pa, ra, ea, lva, sa, ma, ta, pb, rb, eb, lvb, sb, mb, tb);
  return (r.z, 0.0);
}

// --- integration -------------------------------------------------------------

/// Semi-implicit Euler step (dt = 1 frame): advance the centre by `lvel` and spin `rot` by `spin.x`
/// (small-angle `rot + perp(rot)·ω`, renormalised — no trig, no drift). The driver adds gravity to `lvel`
/// first. A temp holds the spun vector (writing `rot` from an RHS that reads it twice self-aliases).
integrate :: map (query { pos, lvel, spin, rot })(pos, rot) {
  spun := rot + perp(rot) * spin.x;
  pos = pos + lvel;
  rot = normalize(spun);
}

// --- solver ------------------------------------------------------------------

/// Solver phase 1a (Jacobi, LINEAR): each body folds the linear impulse from every other body into `dimp`,
/// reading a velocity snapshot. Run the solve trio several times in the schedule for a stiffer solve.
solve_lin :: system (query { pos, rot, ext, lvel, spin, mi, mat } as All) {
  map (query { pos, rot, ext, lvel, spin, mi, mat, dimp } as me)(dimp) {
    dimp = reduce(+, imp_lin(me.pos, me.rot, me.ext, me.lvel, me.spin, me.mi, me.mat,
                             All.pos, All.rot, All.ext, All.lvel, All.spin, All.mi, All.mat));
  };
}

/// Solver phase 1b (Jacobi, ANGULAR): each body folds the angular impulse into `dang.x` from the SAME
/// pre-`apply` snapshot as `solve_lin`.
solve_ang :: system (query { pos, rot, ext, lvel, spin, mi, mat } as All) {
  map (query { pos, rot, ext, lvel, spin, mi, mat, dang } as me)(dang) {
    dang = reduce(+, imp_ang(me.pos, me.rot, me.ext, me.lvel, me.spin, me.mi, me.mat,
                             All.pos, All.rot, All.ext, All.lvel, All.spin, All.mi, All.mat));
  };
}

/// Under-relaxation factor for the Jacobi solve: applying only a FRACTION of each iteration's impulse and
/// iterating more converges (full Jacobi over many simultaneous contacts overshoots and diverges — bodies
/// gain energy and fly apart). Run the solve trio ~6–8× per frame with this.
RELAX :: 0.5;

/// Solver phase 2: commit a relaxed share of the accumulated linear + angular impulses to the velocities.
apply :: map (query { lvel, spin, dimp, dang })(lvel, spin) {
  lvel   = lvel + dimp * RELAX;
  spin.x = spin.x + dang.x * RELAX;
}

// --- positional de-penetration (Baumgarte-free split, like physics.collide) --

/// The positional correction body A receives from overlapping B: move A along −n by a mass-weighted share
/// of the penetration (× BETA so a stack settles without jitter). `n` points A→B, so A backs off along −n.
/// Zero for a separated or self/coincident pair. Reads positions only (writes `cor`); `apply_pos` commits.
BETA :: 0.8;
cor_of :: func(pa: pos, ra: pos, ea: pos, ma: mi, pb: pos, rb: pos, eb: pos, mb: mi) -> pos {
  st  := sat(pa, ra, ea, pb, rb, eb);
  n   := vec.mk(st.x, st.y);
  sep := pb - pa;
  far := select(sep.x * sep.x + sep.y * sep.y > 0.0001, 1.0, 0.0);
  hit := select(st.z > 0.0, far, 0.0);
  wsum := ma.x + mb.x;
  wa   := select(wsum > 0.0, ma.x / wsum, 0.0);          // A's share of the separation (0 if A static)
  return n * (0.0 - st.z * wa * BETA * hit);
}

/// Positional solver (phase 1): each body folds its de-penetration offset into `cor` (positions snapshot).
solve_pos :: system (query { pos, rot, ext, mi } as All) {
  map (query { pos, rot, ext, mi, cor } as me)(cor) {
    cor = reduce(+, cor_of(me.pos, me.rot, me.ext, me.mi, All.pos, All.rot, All.ext, All.mi));
  };
}

/// Positional solver (phase 2): commit the de-penetration offset to the centre.
apply_pos :: map (query { pos, cor })(pos) {
  pos = pos + cor;
}
