/// Behavior for the `rigid` device — 2D rigid-body dynamics with ROTATION over oriented boxes (OBBs): SAT
/// collision detection, a 2-point contact manifold, and a SUBSTEPPED soft-constraint velocity solver
/// (Box2D-v3 "TGS-Soft" flavour). The full-fat companion to the AABB `physics` device.
///
/// The frame is advanced in SUBSTEPS(16) small steps of DT=1/16. Each substep: (driver) gravity, then
/// `contacts` (count each body's active contacts for mass-splitting), then a few soft-constraint velocity
/// iterations, then `integrate` (position by lvel·DT). RIGIDITY comes from this small step + the soft
/// velocity bias (the normal impulse drives contacts to a small SEPARATING target ∝ penetration, removing
/// overlap in VELOCITY space) — so there is NO positional/Baumgarte pass, which is what eliminated the old
/// "sink then spring" squish. The per-substep work is the boids self-join `reduce`: each body folds the
/// pairwise impulse from every other body into an accumulator (a velocity SNAPSHOT read), then `apply`
/// commits it — Jacobi, data-parallel, order-independent (⇒ deterministic). Split into a LINEAR + ANGULAR
/// reduce (`solve_lin`/`solve_ang`) because each fold is a 2-vector (the impulse is 3 numbers). The PRIMARY
/// Jacobi stabiliser is MASS-SPLITTING (each body scales its response by 1/activeContacts), not
/// under-relaxation. Orientation is a unit vector (no trig): spun by renormalising `rot + perp(rot)·ω·DT`.
/// (Restitution + explicit warm-starting are Stage 2.)
///
/// Per-body scalars are packed into 2-vector `x` (`spin`/`mi`/`mat`/`dang`) — see the datasheet for why.
/// Systems are device-qualified in a driver's schedule (`rigid.solve_lin`, …), like the `physics` device.
#import { vec }

/// An oriented rigid body. `lvel`=linear vel, `spin.x`=angular vel, `rot`=orientation unit-vec,
/// `ext`=half-extents, `mi`=(invMass,invInertia), `mat`=(restitution,friction), `dimp`/`dang`=impulse
/// accumulators, `cor.x`=per-body active-contact count (for mass-splitting). Seed `rot=(1,0)` for angle 0
/// and `mi=(0,0)` for a static body.
RBody :: arche { pos, lvel, spin, rot, ext, mi, mat, dimp, dang, cor }

// --- vector helpers (pure, branch-free) --------------------------------------

/// Rotate a local-frame vector `v` into world by the orientation unit-vector `r` — a complex multiply.
rotate :: func(v: pos, r: pos) -> pos {
  return (v.x * r.x - v.y * r.y, v.x * r.y + v.y * r.x);
}

/// Left perpendicular (90° CCW): `(x, y) -> (-y, x)`.
perp :: func(v: pos) -> pos {
  return (0.0 - v.y, v.x);
}

/// 2D scalar cross product `a × b = ax·by − ay·bx` — the lever-arm term.
cross :: func(a: pos, b: pos) -> float {
  return a.x * b.y - a.y * b.x;
}

/// Angular-velocity (scalar) crossed with a radius vector: `ω × r = (−ω·ry, ω·rx)`.
crossw :: func(w: float, r: pos) -> pos {
  return (0.0 - w * r.y, w * r.x);
}

/// Normalise to unit length.
normalize :: func(v: pos) -> pos {
  l := sqrt(v.x * v.x + v.y * v.y);
  return v * (1.0 / l);
}

/// Component-wise vector select (`select` does not lower on whole-vector operands): `c==1 ? a : b`.
vsel :: func(c: int, a: pos, b: pos) -> pos {
  return vec.mk(select(c == 1, a.x, b.x), select(c == 1, a.y, b.y));
}

// --- collision detection (separating-axis test over oriented boxes) ----------

/// Half-width of an OBB projected onto a unit axis `n`, given its world axes `ax`/`ay` and half-extents.
obb_radius :: func(ax: pos, ay: pos, ext: pos, n: pos) -> float {
  return ext.x * vec.absf(vec.dot(ax, n)) + ext.y * vec.absf(vec.dot(ay, n));
}

/// Signed overlap of boxes A and B along unit axis `n`: `(radiusA + radiusB) − |(cB−cA)·n|`. >0 overlap.
axis_overlap :: func(n: pos, pa: pos, axa: pos, aya: pos, ea: pos, pb: pos, axb: pos, ayb: pos, eb: pos) -> float {
  ra := obb_radius(axa, aya, ea, n);
  rb := obb_radius(axb, ayb, eb, n);
  return ra + rb - vec.absf(vec.dot(pb - pa, n));
}

/// The 2D separating-axis test between two OBBs. Returns `(normal.x, normal.y, penetration)` as a `pos3`:
/// the normal is the least-overlap axis (MTV direction), signed A→B; `penetration < 0` ⇒ disjoint.
sat :: func(pa: pos, ra: pos, ea: pos, pb: pos, rb: pos, eb: pos) -> pos3 {
  axa := ra;  aya := perp(ra);
  axb := rb;  ayb := perp(rb);
  o0 := axis_overlap(axa, pa, axa, aya, ea, pb, axb, ayb, eb);
  o1 := axis_overlap(aya, pa, axa, aya, ea, pb, axb, ayb, eb);
  o2 := axis_overlap(axb, pa, axa, aya, ea, pb, axb, ayb, eb);
  o3 := axis_overlap(ayb, pa, axa, aya, ea, pb, axb, ayb, eb);
  bx := axa.x;  by := axa.y;  bo := o0;
  c1 := o1 < bo;  bx = select(c1, aya.x, bx);  by = select(c1, aya.y, by);  bo = select(c1, o1, bo);
  c2 := o2 < bo;  bx = select(c2, axb.x, bx);  by = select(c2, axb.y, by);  bo = select(c2, o2, bo);
  c3 := o3 < bo;  bx = select(c3, ayb.x, bx);  by = select(c3, ayb.y, by);  bo = select(c3, o3, bo);
  nrm  := vec.mk(bx, by);
  flip := vec.dot(pb - pa, nrm) < 0.0;
  sx := select(flip, 0.0 - bx, bx);
  sy := select(flip, 0.0 - by, by);
  return (sx, sy, bo);
}

// --- contact resolution (soft-constraint VELOCITY impulse + friction + spin) --

/// TGS substepping: the frame is advanced in SUBSTEPS small steps of DT frames each. Rigidity comes from the
/// small step + the soft-constraint velocity bias below (penetration is removed in velocity space, so there
/// is NO separate positional / Baumgarte pass — that was the source of the old "sink then spring" squish).
SUBSTEPS :: 16;
DT       :: 0.0625;   // 1 / SUBSTEPS — frame fraction advanced per substep
INV_DT   :: 16.0;     // SUBSTEPS

/// Soft-constraint contact parameters (Box2D-v3 "TGS-Soft"), precomputed for a target stiffness of ≈3 contact
/// cycles per frame at critical damping (ζ=1) and step dt = DT: with ω = 2π·3, c = DT·ω·(2ζ+DT·ω),
/// biasRate = ω/(2ζ+DT·ω) ≈ 5.93, massScale = c/(1+c) ≈ 0.789. (impulseScale — the warm-start-λ leak term —
/// arrives with Stage-2 warm-starting; Stage 1 has no persisted λ, so it is 0.)
BIAS_RATE  :: 5.93;
MASS_SCALE :: 0.789;

/// Minimum closing speed for restitution to apply (used by the Stage-2 restitution pass); also the
/// resting-contact gate. Kept as a device constant.
REST_SLOP :: 1.0;

/// One contact's SOFT-CONSTRAINT velocity impulse ON body A at point `c`, normal `n` (A→B), overlap depth
/// `pen` (>0). The normal impulse drives the contact toward a small SEPARATING target velocity BIAS_RATE·pen
/// (soft spring-damper in velocity space) and is NON-attractive (`jn ≥ 0`) — this removes penetration without
/// a position pass. `ms` is body A's mass-SPLIT factor (1/activeContacts on A) applied to A's inverse
/// mass+inertia: the PRIMARY Jacobi stabiliser — each of A's simultaneous contacts sees a proportionally
/// heavier body, so their summed impulses don't overshoot (this replaces ad-hoc under-relaxation). Coulomb
/// friction clamps the tangent impulse to μ·jn (the pure normal impulse). Returns A's (Δlvel.x, Δlvel.y, Δω).
contact_impulse :: func(c: pos, n: pos, pen: float, mu: float, hit: float, ms: float,
                        pa: pos, lva: pos, wa: float, ma: mi,
                        pb: pos, lvb: pos, wb: float, mb: mi) -> pos3 {
  rA := c - pa;  rB := c - pb;
  vA := lva + crossw(wa, rA);
  vB := lvb + crossw(wb, rB);
  vrel := vB - vA;
  vn  := vec.dot(vrel, n);
  mxa := ma.x * ms;  mya := ma.y * ms;           // mass-split A's inverse mass / inertia
  rnA := cross(rA, n);  rnB := cross(rB, n);
  kn0 := mxa + mb.x + mya * rnA * rnA + mb.y * rnB * rnB;
  kn  := select(kn0 > 0.0, kn0, 1.0);            // guard the divide (static–static / self pair)
  vtar := BIAS_RATE * pen;                        // overlap → target separating velocity (soft bias)
  jn0 := MASS_SCALE * (vtar - vn) / kn * hit;
  jn  := select(jn0 > 0.0, jn0, 0.0);            // non-attractive normal impulse
  t   := perp(n);
  vt  := vec.dot(vrel, t);
  rtA := cross(rA, t);  rtB := cross(rB, t);
  kt0 := mxa + mb.x + mya * rtA * rtA + mb.y * rtB * rtB;
  kt  := select(kt0 > 0.0, kt0, 1.0);
  jt0 := (0.0 - vt) / kt * hit;
  lim := mu * jn;                                 // Coulomb cone bounded by the (pure) normal impulse
  jt  := select(jt0 > lim, lim, select(jt0 < 0.0 - lim, 0.0 - lim, jt0));
  p   := n * jn + t * jt;
  dl  := p * (0.0 - mxa);
  dw  := (0.0 - mya) * cross(rA, p);
  return (dl.x, dl.y, dw);
}

/// The velocity change body A receives from its contact with B — a TWO-POINT manifold, which is what lets a
/// box rest FLAT and stack (two touching corners give opposing torques that cancel spin; a single point
/// would tip it). The manifold is the INCIDENT box's face vertices: SAT gives the normal and the REFERENCE
/// box (the one the normal is a face of); the incident box's face toward it has two vertices, and EACH is a
/// contact only if it actually penetrates the reference face (below it, within its tangential span). So a
/// box flat on the floor has BOTH corners in contact (rests flat), while a box tipped on one corner has
/// only that corner (it topples). Returns A's (Δlvel.x, Δlvel.y, Δω); the load is split 1/activeContacts.
pair_response :: func(pa: pos, ra: pos, ea: pos, lva: pos, sa: spin, ma: mi, ta: mat, ms: float,
                      pb: pos, rb: pos, eb: pos, lvb: pos, sb: spin, mb: mi, tb: mat) -> pos3 {
  mu := select(ta.y < tb.y, ta.y, tb.y);   // friction = min of the pair (restitution → Stage-2 pass)
  st  := sat(pa, ra, ea, pb, rb, eb);
  n   := vec.mk(st.x, st.y);
  sep := pb - pa;
  far := select(sep.x * sep.x + sep.y * sep.y > 0.0001, 1.0, 0.0);   // 0 for a self/coincident pair
  hit := select(st.z > 0.0, far, 0.0);
  axa := ra;  aya := perp(ra);
  axb := rb;  ayb := perp(rb);
  // REFERENCE = the box whose face the SAT normal is (n is exactly one box's axis). INCIDENT = the other.
  aref := select(vec.absf(vec.dot(n, axa)) > 0.99, 1, select(vec.absf(vec.dot(n, aya)) > 0.99, 1, 0));
  rn  := vsel(aref, n, vec.mk(0.0 - n.x, 0.0 - n.y));   // reference → incident direction
  ip  := vsel(aref, pb, pa);                             // incident box
  iax := vsel(aref, axb, axa);
  iay := vsel(aref, ayb, aya);
  iex := select(aref == 1, eb.x, ea.x);
  iey := select(aref == 1, eb.y, ea.y);
  rp  := vsel(aref, pa, pb);                             // reference box
  rax := vsel(aref, axa, axb);
  ray := vsel(aref, aya, ayb);
  rex := select(aref == 1, ea.x, eb.x);
  rey := select(aref == 1, ea.y, eb.y);
  rext := vec.mk(rex, rey);
  // incident FACE = perpendicular to whichever incident axis lies most along rn; its two vertices:
  dax := vec.dot(iax, rn);  day := vec.dot(iay, rn);
  useX := select(vec.absf(dax) >= vec.absf(day), 1, 0);
  faceAxis := vsel(useX, iax, iay);
  faceExt  := select(useX == 1, iex, iey);
  perpAxis := vsel(useX, iay, iax);
  perpExt  := select(useX == 1, iey, iex);
  dsel := select(useX == 1, dax, day);
  sn := select(dsel > 0.0, 0.0 - 1.0, 1.0);              // face on the side opposing rn
  fc := ip + faceAxis * (sn * faceExt);
  v1 := fc + perpAxis * perpExt;
  v2 := fc - perpAxis * perpExt;
  // reference surface + tangential span (a vertex is a contact only if past the surface AND over the face)
  sref := vec.dot(rp, rn) + obb_radius(rax, ray, rext, rn);
  tr := perp(rn);
  rc := vec.dot(rp, tr);  rr := obb_radius(rax, ray, rext, tr);
  lo := rc - rr;  hi := rc + rr;
  pen1 := sref - vec.dot(v1, rn);   t1 := vec.dot(v1, tr);
  pen2 := sref - vec.dot(v2, rn);   t2 := vec.dot(v2, tr);
  // CLIP each incident vertex into the reference face's tangential span [lo,hi] (Sutherland-Hodgman): slide
  // it along the face tangent to the span edge. Rejecting out-of-span vertices instead (the old test) loses
  // BOTH contacts whenever the incident box is larger than the reference — e.g. any box on a wide floor, its
  // corners sit far past the box, so nothing registers and the contact resolves by position only (velocity
  // jitter). Clamping turns the floor's far corners into the two points directly under the box's edges.
  t1c := select(t1 < lo, lo, select(t1 > hi, hi, t1));
  t2c := select(t2 < lo, lo, select(t2 > hi, hi, t2));
  c1 := v1 + tr * (t1c - t1);
  c2 := v2 + tr * (t2c - t2);
  hit1 := hit * select(pen1 > 0.0, 1.0, 0.0);
  hit2 := hit * select(pen2 > 0.0, 1.0, 0.0);
  r1  := contact_impulse(c1, n, pen1, mu, hit1, ms, pa, lva, sa.x, ma, pb, lvb, sb.x, mb);
  r2  := contact_impulse(c2, n, pen2, mu, hit2, ms, pa, lva, sa.x, ma, pb, lvb, sb.x, mb);
  return (r1.x + r2.x, r1.y + r2.y, r1.z + r2.z);
}

/// Linear velocity change body A receives from B — the (Δlvel) half of the 2-point response. Folded over B.
imp_lin :: func(pa: pos, ra: pos, ea: pos, lva: pos, sa: spin, ma: mi, ta: mat, ms: float,
                pb: pos, rb: pos, eb: pos, lvb: pos, sb: spin, mb: mi, tb: mat) -> pos {
  r := pair_response(pa, ra, ea, lva, sa, ma, ta, ms, pb, rb, eb, lvb, sb, mb, tb);
  return vec.mk(r.x, r.y);
}

/// Angular velocity change body A receives from B — the (Δω) half, packed as a `spin` for the 2-vec reduce.
imp_ang :: func(pa: pos, ra: pos, ea: pos, lva: pos, sa: spin, ma: mi, ta: mat, ms: float,
                pb: pos, rb: pos, eb: pos, lvb: pos, sb: spin, mb: mi, tb: mat) -> spin {
  r := pair_response(pa, ra, ea, lva, sa, ma, ta, ms, pb, rb, eb, lvb, sb, mb, tb);
  return (r.z, 0.0);
}

/// The number of ACTIVE contact points (0, 1 or 2) between boxes A and B — the same 2-point manifold gate as
/// `pair_response` (a vertex counts once it penetrates the reference face), minus the impulse. Summed over B
/// by the `contacts` pass to give each body its active-contact count for mass-splitting. Mirrors the manifold
/// detection in `pair_response` (the tangential clip does not affect the penetration gate, so it's omitted).
pair_count :: func(pa: pos, ra: pos, ea: pos, pb: pos, rb: pos, eb: pos) -> cor {
  st  := sat(pa, ra, ea, pb, rb, eb);
  n   := vec.mk(st.x, st.y);
  sep := pb - pa;
  far := select(sep.x * sep.x + sep.y * sep.y > 0.0001, 1.0, 0.0);
  hit := select(st.z > 0.0, far, 0.0);
  axa := ra;  aya := perp(ra);
  axb := rb;  ayb := perp(rb);
  aref := select(vec.absf(vec.dot(n, axa)) > 0.99, 1, select(vec.absf(vec.dot(n, aya)) > 0.99, 1, 0));
  rn  := vsel(aref, n, vec.mk(0.0 - n.x, 0.0 - n.y));
  ip  := vsel(aref, pb, pa);
  iax := vsel(aref, axb, axa);
  iay := vsel(aref, ayb, aya);
  iex := select(aref == 1, eb.x, ea.x);
  iey := select(aref == 1, eb.y, ea.y);
  rp  := vsel(aref, pa, pb);
  rax := vsel(aref, axa, axb);
  ray := vsel(aref, aya, ayb);
  rex := select(aref == 1, ea.x, eb.x);
  rey := select(aref == 1, ea.y, eb.y);
  rext := vec.mk(rex, rey);
  dax := vec.dot(iax, rn);  day := vec.dot(iay, rn);
  useX := select(vec.absf(dax) >= vec.absf(day), 1, 0);
  faceAxis := vsel(useX, iax, iay);
  faceExt  := select(useX == 1, iex, iey);
  perpAxis := vsel(useX, iay, iax);
  perpExt  := select(useX == 1, iey, iex);
  dsel := select(useX == 1, dax, day);
  sn := select(dsel > 0.0, 0.0 - 1.0, 1.0);
  fc := ip + faceAxis * (sn * faceExt);
  v1 := fc + perpAxis * perpExt;
  v2 := fc - perpAxis * perpExt;
  sref := vec.dot(rp, rn) + obb_radius(rax, ray, rext, rn);
  pen1 := sref - vec.dot(v1, rn);
  pen2 := sref - vec.dot(v2, rn);
  h1 := select(pen1 > 0.0, 1.0, 0.0);
  h2 := select(pen2 > 0.0, 1.0, 0.0);
  // count 0/1/2 via nested select (a bare float `hit1 + hit2` of two arithmetic locals here mis-compiles to
  // an integer add — a `+` type-inference bug; nested select sidesteps it and stays branch-free).
  both := select(h1 > 0.5, select(h2 > 0.5, 2.0, 1.0), select(h2 > 0.5, 1.0, 0.0));
  cnt := both * hit;    // bind to a local first: a binary op directly in a return-tuple slot mis-types as int
  return (cnt, 0.0);
}

// --- integration -------------------------------------------------------------

/// Semi-implicit Euler SUBSTEP (dt = DT frames): advance the centre by `lvel·DT` and spin `rot` by
/// `spin.x·DT` (small-angle `rot + perp(rot)·ω`, renormalised — no trig, no drift). Run once per substep,
/// after the substep's velocity solve. The driver adds gravity (`·DT`) to `lvel` first. A temp holds the
/// spun vector (writing `rot` from an RHS that reads it twice self-aliases).
integrate :: map (query { pos, lvel, spin, rot })(pos, rot) {
  spun := rot + perp(rot) * (spin.x * DT);
  pos = pos + lvel * DT;
  rot = normalize(spun);
}

// --- solver ------------------------------------------------------------------

/// Contact-count pass (run once per substep, before the velocity solve): each body folds `pair_count` over
/// every other body into `cor.x` = its number of active contact points. This is the divisor for the
/// mass-split factor `ms` used by the solve — the PRIMARY Jacobi stabiliser (a body with N simultaneous
/// contacts scales each contact's response by 1/N so their sum doesn't overshoot). `cor` (once the positional
/// accumulator, now unused by the velocity-space solver) is repurposed as this count.
contacts :: system (query { pos, rot, ext } as All) {
  map (query { pos, rot, ext, cor } as me)(cor) {
    cor = reduce(+, pair_count(me.pos, me.rot, me.ext, All.pos, All.rot, All.ext));
  };
}

/// Solve phase 1a (Jacobi, LINEAR): each body folds the soft-constraint linear impulse from every other body
/// into `dimp`, reading a velocity snapshot, mass-split by `ms = 1/max(cor.x,1)`. Iterate the trio a few
/// times per substep.
solve_lin :: system (query { pos, rot, ext, lvel, spin, mi, mat, cor } as All) {
  map (query { pos, rot, ext, lvel, spin, mi, mat, cor, dimp } as me)(dimp) {
    ms := 1.0 / select(me.cor.x > 1.0, me.cor.x, 1.0);
    dimp = reduce(+, imp_lin(me.pos, me.rot, me.ext, me.lvel, me.spin, me.mi, me.mat, ms,
                             All.pos, All.rot, All.ext, All.lvel, All.spin, All.mi, All.mat));
  };
}

/// Solve phase 1b (Jacobi, ANGULAR): folds the angular impulse into `dang.x` from the SAME snapshot + `ms`.
solve_ang :: system (query { pos, rot, ext, lvel, spin, mi, mat, cor } as All) {
  map (query { pos, rot, ext, lvel, spin, mi, mat, cor, dang } as me)(dang) {
    ms := 1.0 / select(me.cor.x > 1.0, me.cor.x, 1.0);
    dang = reduce(+, imp_ang(me.pos, me.rot, me.ext, me.lvel, me.spin, me.mi, me.mat, ms,
                             All.pos, All.rot, All.ext, All.lvel, All.spin, All.mi, All.mat));
  };
}

/// Solve phase 2: commit the accumulated linear + angular impulses. No under-relaxation — mass-splitting in
/// the solve already prevents overshoot, so each iteration commits in full.
apply :: map (query { lvel, spin, dimp, dang })(lvel, spin) {
  lvel   = lvel + dimp;
  spin.x = spin.x + dang.x;
}

/// Resting stabilization ("sleep"), run once per frame after the solve: a body moving below the thresholds
/// is snapped to a dead stop, killing the last of the settle jitter once under-relaxation has let its
/// velocity decay. (No always-on damping — that would slow free-fall too.)
/// V_SLEEP must stay BELOW the driver's per-frame gravity so a free-falling (or momentarily-slowed) body
/// always exceeds it — otherwise gravity can't out-run the clamp and a body freezes in mid-air.
V_SLEEP :: 0.3;
W_SLEEP :: 0.02;
// Angular damping only (ADAMP): a box toppling from an angle ROCKS on the floor, and that spin re-energises
// it above the sleep threshold forever; bleeding angular velocity lets the rock die. Linear velocity is NOT
// damped (that would slow free-fall). Squared thresholds + NO func call — `vec.len`/`vec.absf` inside a
// MULTI-archetype map mis-compile (the vec arg is read as an int); plain arithmetic + select are safe.
ADAMP :: 0.90;
rest :: map (query { lvel, spin })(lvel, spin) {
  dw := spin.x * ADAMP;
  v2 := lvel.x * lvel.x + lvel.y * lvel.y;
  w2 := dw * dw;
  awake := select(v2 > V_SLEEP * V_SLEEP, 1.0, select(w2 > W_SLEEP * W_SLEEP, 1.0, 0.0));
  lvel   = lvel * awake;
  spin.x = dw * awake;
}

// (No positional de-penetration pass: the soft-constraint velocity bias removes penetration in velocity
// space, integrated to position by `integrate`. This is what eliminates the old Baumgarte "sink & spring".)
