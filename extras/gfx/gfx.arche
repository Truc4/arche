/// Build the open effect as an `Eff(window)`; a boot system runs it (`gfx.open(w,h,title)(win:)`) and
/// inserts the handle into its Window pool.
open :: func(w: int, h: int, own title: []char) -> Eff(window) {
  return gfx_be_open(w, h, move title);
}

/// A window's dimensions, as ONE Eff via the applicative product `zip` of two backend reads. A draw system
/// binds both at once: `gfx.dims(handle)(w:, h:)`. The framebuffer itself is the driver-owned `Framebuffer`
/// pool (below), sliced as `Framebuffer.pixel[0 : Framebuffer.capacity]` — not a shim-owned buffer.
dims :: func(h: window) -> Eff(int, int) {
  return zip(gfx_be_w(h), gfx_be_h(h));
}

/// The framebuffer as data — one `int` column of 0xRRGGBB pixels, row-major. gfx declares the shape; the
/// driver owns and sizes the pool (`[W*H]Framebuffer`). Rasterizers write it through a `[]int` slice.
Framebuffer :: arche { pixel }

/// Fill the framebuffer with each window's `bg` colour (0xRRGGBB).
clear :: system eff {
  view := Framebuffer.pixel[0: Framebuffer.capacity]; // slice at the composer top level (a query fan would auto-index it)
  map (query { handle, bg }) eff {
    dims(handle)(w:, h:);
    n := w * h;
    for (i := 0; i < n; i += 1) {
      view[i] = bg;
    }
  };
}

/// Present the framebuffer (the driver-owned pool) to the window.
present :: system eff {
  view := Framebuffer.pixel[0: Framebuffer.capacity]; // slice at the composer top level (a query fan would auto-index it)
  map (query { handle }) eff {
    dims(handle)(w:, h:);
    gfx_be_present(handle, view, w, h)(_:); // px is in-out (FFI borrow rule); present only reads it
  };
}

/// A window-close event as data: empty while open, one row once closed. The driver owns `[1]Closed` and
/// reacts (e.g. an `map (Closed) eff` that halts). `at` is the close stamp.
Closed :: arche { at }

poll :: system eff {
  map (query { handle }) eff {
    gfx_be_poll(handle)(r:);
    if (!r) {
      insert(Closed { at: 0 })(_:, _ok:);
    }
  };
}
