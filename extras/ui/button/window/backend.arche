#import { ui }

BTN_BG    :: 0xe4694e;
BTN_LABEL :: 0x160d0a;
BTN_TSZ   :: 16;

// Two passes, one kernel — same as the panel device. `render` draws the FOREGROUND buttons (z >= SPLIT_Z) and
// `render_bg` the BACKGROUND ones (z < SPLIT_Z), so a control on a background panel is drawn at that panel's
// depth rather than floating in front of the world. A button on the wrong side of the split collapses to a
// zero-size rect, so its scan loops never run.
render :: system (query { framebuffer })(framebuffer) eff {
  map (query { screen, size, label, len, view, z }) eff {
    live := select(z >= ui.SPLIT_Z, 1, 0);
    fx0 := screen.x;
    fy0 := screen.y;
    fx1 := screen.x + size.w * live;
    fy1 := screen.y + size.h * live;
    if (fx0 < 0) {
      fx0 = 0;
    }
    if (fy0 < 0) {
      fy0 = 0;
    }
    if (fx1 > view.w) {
      fx1 = view.w;
    }
    if (fy1 > view.h) {
      fy1 = view.h;
    }
    for (yy := fy0; yy < fy1; yy += 1) {
      for (xx := fx0; xx < fx1; xx += 1) {
        framebuffer[yy * view.w + xx] = BTN_BG;
      }
    }
    s   := BTN_TSZ / 8;
    adv := 8 * s;
    lw  := len * adv;
    lx  := screen.x + (size.w - lw) / 2;
    ly  := screen.y + (size.h - BTN_TSZ) / 2;
    nl := len * live;
    for (i := 0; i < nl; i += 1) {
      c := label[i];
      if (c >= 32 && c <= 126) {
        gi := c - 32;
        for (row := 0; row < 8; row += 1) {
          b := ui.GLYPHS[gi * 8 + row];
          for (col := 0; col < 8; col += 1) {
            if (b >= 128) {
              gx0 := lx + i * adv + col * s;
              gy0 := ly + row * s;
              for (py := gy0; py < gy0 + s; py += 1) {
                if (py >= fy0 && py < fy1) {
                  for (px := gx0; px < gx0 + s; px += 1) {
                    if (px >= fx0 && px < fx1) {
                      framebuffer[py * view.w + px] = BTN_LABEL;
                    }
                  }
                }
              }
              b = b - 128;
            }
            b = b * 2;
          }
        }
      }
    }
  };
}

render_bg :: system (query { framebuffer })(framebuffer) eff {
  map (query { screen, size, label, len, view, z }) eff {
    live := select(z < ui.SPLIT_Z, 1, 0);
    fx0 := screen.x;
    fy0 := screen.y;
    fx1 := screen.x + size.w * live;
    fy1 := screen.y + size.h * live;
    if (fx0 < 0) {
      fx0 = 0;
    }
    if (fy0 < 0) {
      fy0 = 0;
    }
    if (fx1 > view.w) {
      fx1 = view.w;
    }
    if (fy1 > view.h) {
      fy1 = view.h;
    }
    for (yy := fy0; yy < fy1; yy += 1) {
      for (xx := fx0; xx < fx1; xx += 1) {
        framebuffer[yy * view.w + xx] = BTN_BG;
      }
    }
    s   := BTN_TSZ / 8;
    adv := 8 * s;
    lw  := len * adv;
    lx  := screen.x + (size.w - lw) / 2;
    ly  := screen.y + (size.h - BTN_TSZ) / 2;
    nl := len * live;
    for (i := 0; i < nl; i += 1) {
      c := label[i];
      if (c >= 32 && c <= 126) {
        gi := c - 32;
        for (row := 0; row < 8; row += 1) {
          b := ui.GLYPHS[gi * 8 + row];
          for (col := 0; col < 8; col += 1) {
            if (b >= 128) {
              gx0 := lx + i * adv + col * s;
              gy0 := ly + row * s;
              for (py := gy0; py < gy0 + s; py += 1) {
                if (py >= fy0 && py < fy1) {
                  for (px := gx0; px < gx0 + s; px += 1) {
                    if (px >= fx0 && px < fx1) {
                      framebuffer[py * view.w + px] = BTN_LABEL;
                    }
                  }
                }
              }
              b = b - 128;
            }
            b = b * 2;
          }
        }
      }
    }
  };
}

// `clicked` is the rising EDGE (went down this frame); `held` is the LEVEL (is down right now). A movement
// pad needs the level — an edge would step the player once per tap instead of walking while pressed.
poll :: system eff {
  map (query { screen, size, clicked, held, wasdown, mouse, mouse_down })(clicked, held, wasdown) eff {
    inside := mouse.x >= screen.x && mouse.x < screen.x + size.w && mouse.y >= screen.y && mouse.y < screen.y + size.h;
    clicked = 0;
    held = 0;
    if (mouse_down == 1 && inside) {
      held = 1;
      if (wasdown == 0) {
        clicked = 1;
      }
    }
    wasdown = mouse_down;
  };
}
