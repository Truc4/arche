/// DOM backend for `button` — merged under `[select] button = "dom"`. No C shim: the `button_be_*` seams are
/// wasm imports the JS host fulfils with a real `<button>` that mounts inside the panel frame. Same interface as
/// the window backend (`render` sets the label, `poll` drains the click), so the two are interchangeable.
#module
#foreign
button_be_label :: proc(s: []char, n: int)(s: []char); // set the button's text
#foreign
button_be_poll  :: proc()(clicked: int);               // 1 once per click, else 0

render :: system eff {
  map (query { blabel, blen }) eff {
    button_be_label(blabel, blen)(_:);
  };
}

poll :: system eff {
  map (query { bclicked })(bclicked) eff {
    button_be_poll()(c:);
    bclicked = c;
  };
}
