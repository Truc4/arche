/// textedit=x11in — the editor as a REAL X11 child window embedded in the gfx scene window (not a
/// separate top-level). The OS delivers focus + key events; the C shim (textedit_x11in.c) draws the text
/// with a core X server font and owns the child window, parented to the scene window via gfx_x11_window().
/// arche only seeds it (open), positions it (render → place), pulls the buffer back (text), and polls the
/// Ctrl-R edge (poll_run). Native analog of the dom backend's <textarea>. Requires gfx=x11.
// RUN: true
#import { gfx }
#link {
  "X11"
}

#module
#foreign
textedit_be_open :: proc(win: window, buf: []char, n: int, bg: int, fg: int)(buf: []char);
#foreign
textedit_be_text :: proc(buf: []char, cap: int)(buf: []char);
#foreign
textedit_be_poll_run :: proc()(r: int);
#foreign
textedit_be_place :: proc(x: int, y: int, w: int, h: int)();

// Create the child window once, parented to the scene window (handle), seeded from the source buffer.
open :: system eff {
  map (query { handle }) eff {
    map (query { source, bg, fg }) eff {
      textedit_be_open(handle, source, source.length, bg, fg)(_:);
    };
  };
}

// Each frame: the shim drains OS key input + redraws, then writes its edit buffer back into `source`.
text :: system eff {
  map (query { source, len })(source, len) eff {
    textedit_be_text(_, source.length)(source);
    len = 0;
    for (; len < source.length && source[len] != 0; len += 1) {
    }
  };
}

// Ctrl-R inside the editor raises submit (same flag the RUN button / browser Ctrl-Enter raise).
poll_run :: system eff {
  map (query { submit })(submit) eff {
    textedit_be_poll_run()(r:);
    if (r == 1) {
      submit = 1;
    }
  };
}

// Position the child window from the driver's projected editor rect (render px == window px on x11).
render :: system eff {
  map (query { source, screen, size }) eff {
    textedit_be_place(screen.x, screen.y, size.w, size.h)();
  };
}

step :: system eff {
}
