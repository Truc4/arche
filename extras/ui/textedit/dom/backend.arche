#module
#foreign
textedit_be_open :: proc(buf: []char, n: int)(buf: []char);
#foreign
textedit_be_text :: proc(buf: []char, cap: int)(buf: []char);
#foreign
textedit_be_poll_run :: proc()(r: int);
#foreign
textedit_be_place :: proc(x: int, y: int, w: int, h: int, z: int)();

open :: system eff {
  map (query { source }) eff {
    textedit_be_open(source, source.length)(_:);
  };
}

text :: system eff {
  map (query { source, len })(source, len) eff {
    textedit_be_text(_, source.length)(source);
    len = 0;
    for (; len < source.length && source[len] != 0; len += 1) {
    }
  };
}

poll_run :: system eff {
  map (query { submit })(submit) eff {
    textedit_be_poll_run()(r:);
    if (r == 1) {
      submit = 1;
    }
  };
}

step :: system eff {
}

/* Position the real <textarea> from the driver's projected rect, so the DOM playground lays out from the
 * SAME arche `layout` the native window backend reads — not from CSS. */
render :: system eff {
  map (query { source, screen, size, z }) eff {
    textedit_be_place(screen.x, screen.y, size.w, size.h, z)();
  };
}
