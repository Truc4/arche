#module
#foreign
textview_be_render :: proc(
  bid : int,
  buf : []char,
  n   : int,
  x   : int,
  y   : int,
  w   : int,
  h   : int,
  z   : int,
)(buf: []char);

render :: system eff {
  map (query { bid, output, len, screen, size, z }) eff {
    textview_be_render(bid, output, len, screen.x, screen.y, size.w, size.h, z)(_:);
  };
}
