#import { gfx ui }

// Rasterise every command whose z is in [zlo, zhi) into the driver's framebuffer, in (already sorted) order.
// Reads the driver-owned command buffer (`Cmd`), text arena (`ach`) and z-window (`zlo/zhi`) source-agnostically.
dispatch :: system (query { framebuffer })(framebuffer) eff {
  map (query { handle }) eff {
    gfx.dims(handle)(vw:, vh:);
    map (query { zlo, zhi }) eff {
      map (query { ach }) eff {
        map (query { z, ckind, crx, cry, crw, crh, ccolor, ctoff, ctlen, ctsz, cclx0, ccly0, cclx1, ccly1, cnl }) eff {
          if (z >= zlo && z < zhi) {
            if (ckind == CK_RECT) {
              x0 := crx;
              y0 := cry;
              x1 := crx + crw;
              y1 := cry + crh;
              if (x0 < 0) {
                x0 = 0;
              }
              if (y0 < 0) {
                y0 = 0;
              }
              if (x1 > vw) {
                x1 = vw;
              }
              if (y1 > vh) {
                y1 = vh;
              }
              for (yy := y0; yy < y1; yy += 1) {
                for (xx := x0; xx < x1; xx += 1) {
                  framebuffer[yy * vw + xx] = ccolor;
                }
              }
            } else {
              s := ctsz / 8;
              adv := 8 * s;
              pitch := ctsz + 4;
              penx := crx;
              peny := cry;
              for (i := 0; i < ctlen; i += 1) {
                c := ach[ctoff + i];
                if (cnl == 1 && c == 10) {
                  penx = crx;
                  peny = peny + pitch;
                } else {
                  if (c >= 32 && c <= 126) {
                    gi := c - 32;
                    for (row := 0; row < 8; row += 1) {
                      b := ui.GLYPHS[gi * 8 + row];
                      for (col := 0; col < 8; col += 1) {
                        if (b >= 128) {
                          gx0 := penx + col * s;
                          gy0 := peny + row * s;
                          for (py := gy0; py < gy0 + s; py += 1) {
                            if (py >= ccly0 && py < ccly1 && py >= 0 && py < vh) {
                              for (px := gx0; px < gx0 + s; px += 1) {
                                if (px >= cclx0 && px < cclx1 && px >= 0 && px < vw) {
                                  framebuffer[py * vw + px] = ccolor;
                                }
                              }
                            }
                          }
                          b = b - 128;
                        }
                        b = b * 2;
                      }
                    }
                  }
                  penx = penx + adv;
                }
              }
            }
          }
        };
      };
    };
  };
}
