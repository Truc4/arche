#import { ui }

FRAME_BG     :: 0x0b0e14;
FRAME_BORDER :: 0x232838;
TITLE_COL    :: 0xcdd6f4;
TITLE_TSZ    :: 24;
SUB_COL      :: 0x9298cc;
SUB_TSZ      :: 16;

// Two passes, one kernel. `render` draws the FOREGROUND panels (z >= SPLIT_Z) and `render_bg` the BACKGROUND
// ones (z < SPLIT_Z). A panel on the wrong side of the split collapses to a zero-size rect, so its scan loops
// never run — the same branch-free trick the rest of the device uses instead of control flow.
render :: system (query { framebuffer })(framebuffer) eff {
  map (query { screen, size, title, len, sub, sublen, view, z }) eff {
    live := select(z >= ui.SPLIT_Z, 1, 0);
    bx0  := screen.x;
    by0  := screen.y;
    bx1  := screen.x + size.w * live;
    by1  := screen.y + size.h * live;
    if (bx0 < 0) {
      bx0 = 0;
    }
    if (by0 < 0) {
      by0 = 0;
    }
    if (bx1 > view.w) {
      bx1 = view.w;
    }
    if (by1 > view.h) {
      by1 = view.h;
    }
    for (yy := by0; yy < by1; yy += 1) {
      for (xx := bx0; xx < bx1; xx += 1) {
        framebuffer[yy * view.w + xx] = FRAME_BORDER;
      }
    }
    ix0 := screen.x + 2;
    iy0 := screen.y + 2;
    ix1 := screen.x + size.w * live - 2;
    iy1 := screen.y + size.h * live - 2;
    if (ix0 < 0) {
      ix0 = 0;
    }
    if (iy0 < 0) {
      iy0 = 0;
    }
    if (ix1 > view.w) {
      ix1 = view.w;
    }
    if (iy1 > view.h) {
      iy1 = view.h;
    }
    for (yy := iy0; yy < iy1; yy += 1) {
      for (xx := ix0; xx < ix1; xx += 1) {
        framebuffer[yy * view.w + xx] = FRAME_BG;
      }
    }
    sepy := screen.y + ui.PAD + ui.TITLE_H;
    if (live == 1 && sepy >= 0 && sepy < view.h) {
      for (xx := ix0; xx < ix1; xx += 1) {
        framebuffer[sepy * view.w + xx] = FRAME_BORDER;
      }
    }
    scale := TITLE_TSZ / 8;
    adv   := 8 * scale;
    tx    := screen.x + ui.PAD;
    ty    := screen.y + ui.PAD;
    nt    := len * live;
    for (i := 0; i < nt; i += 1) {
      c := title[i];
      if (c >= 32 && c <= 126) {
        gi := c - 32;
        for (row := 0; row < 8; row += 1) {
          b := ui.GLYPHS[gi * 8 + row];
          for (col := 0; col < 8; col += 1) {
            if (b >= 128) {
              gx0 := tx + i * adv + col * scale;
              gy0 := ty + row * scale;
              for (py := gy0; py < gy0 + scale; py += 1) {
                if (py >= iy0 && py < iy1) {
                  for (px := gx0; px < gx0 + scale; px += 1) {
                    if (px >= ix0 && px < ix1) {
                      framebuffer[py * view.w + px] = TITLE_COL;
                    }
                  }
                }
              }
              b = b - 128;
            }
            b = b * 2;
          }
        }
      }
    }
    sscale := SUB_TSZ / 8;
    sadv   := 8 * sscale;
    sx     := screen.x + ui.PAD;
    sy     := screen.y + ui.PAD + ui.TITLE_H + 12;
    ns     := sublen * live;
    for (i := 0; i < ns; i += 1) {
      c := sub[i];
      if (c >= 32 && c <= 126) {
        gi := c - 32;
        for (row := 0; row < 8; row += 1) {
          b := ui.GLYPHS[gi * 8 + row];
          for (col := 0; col < 8; col += 1) {
            if (b >= 128) {
              gx0 := sx + i * sadv + col * sscale;
              gy0 := sy + row * sscale;
              for (py := gy0; py < gy0 + sscale; py += 1) {
                if (py >= iy0 && py < iy1) {
                  for (px := gx0; px < gx0 + sscale; px += 1) {
                    if (px >= ix0 && px < ix1) {
                      framebuffer[py * view.w + px] = SUB_COL;
                    }
                  }
                }
              }
              b = b - 128;
            }
            b = b * 2;
          }
        }
      }
    }
  };
}

render_bg :: system (query { framebuffer })(framebuffer) eff {
  map (query { screen, size, title, len, sub, sublen, view, z }) eff {
    live := select(z < ui.SPLIT_Z, 1, 0);
    bx0  := screen.x;
    by0  := screen.y;
    bx1  := screen.x + size.w * live;
    by1  := screen.y + size.h * live;
    if (bx0 < 0) {
      bx0 = 0;
    }
    if (by0 < 0) {
      by0 = 0;
    }
    if (bx1 > view.w) {
      bx1 = view.w;
    }
    if (by1 > view.h) {
      by1 = view.h;
    }
    for (yy := by0; yy < by1; yy += 1) {
      for (xx := bx0; xx < bx1; xx += 1) {
        framebuffer[yy * view.w + xx] = FRAME_BORDER;
      }
    }
    ix0 := screen.x + 2;
    iy0 := screen.y + 2;
    ix1 := screen.x + size.w * live - 2;
    iy1 := screen.y + size.h * live - 2;
    if (ix0 < 0) {
      ix0 = 0;
    }
    if (iy0 < 0) {
      iy0 = 0;
    }
    if (ix1 > view.w) {
      ix1 = view.w;
    }
    if (iy1 > view.h) {
      iy1 = view.h;
    }
    for (yy := iy0; yy < iy1; yy += 1) {
      for (xx := ix0; xx < ix1; xx += 1) {
        framebuffer[yy * view.w + xx] = FRAME_BG;
      }
    }
    sepy := screen.y + ui.PAD + ui.TITLE_H;
    if (live == 1 && sepy >= 0 && sepy < view.h) {
      for (xx := ix0; xx < ix1; xx += 1) {
        framebuffer[sepy * view.w + xx] = FRAME_BORDER;
      }
    }
    scale := TITLE_TSZ / 8;
    adv   := 8 * scale;
    tx    := screen.x + ui.PAD;
    ty    := screen.y + ui.PAD;
    nt    := len * live;
    for (i := 0; i < nt; i += 1) {
      c := title[i];
      if (c >= 32 && c <= 126) {
        gi := c - 32;
        for (row := 0; row < 8; row += 1) {
          b := ui.GLYPHS[gi * 8 + row];
          for (col := 0; col < 8; col += 1) {
            if (b >= 128) {
              gx0 := tx + i * adv + col * scale;
              gy0 := ty + row * scale;
              for (py := gy0; py < gy0 + scale; py += 1) {
                if (py >= iy0 && py < iy1) {
                  for (px := gx0; px < gx0 + scale; px += 1) {
                    if (px >= ix0 && px < ix1) {
                      framebuffer[py * view.w + px] = TITLE_COL;
                    }
                  }
                }
              }
              b = b - 128;
            }
            b = b * 2;
          }
        }
      }
    }
    sscale := SUB_TSZ / 8;
    sadv   := 8 * sscale;
    sx     := screen.x + ui.PAD;
    sy     := screen.y + ui.PAD + ui.TITLE_H + 12;
    ns     := sublen * live;
    for (i := 0; i < ns; i += 1) {
      c := sub[i];
      if (c >= 32 && c <= 126) {
        gi := c - 32;
        for (row := 0; row < 8; row += 1) {
          b := ui.GLYPHS[gi * 8 + row];
          for (col := 0; col < 8; col += 1) {
            if (b >= 128) {
              gx0 := sx + i * sadv + col * sscale;
              gy0 := sy + row * sscale;
              for (py := gy0; py < gy0 + sscale; py += 1) {
                if (py >= iy0 && py < iy1) {
                  for (px := gx0; px < gx0 + sscale; px += 1) {
                    if (px >= ix0 && px < ix1) {
                      framebuffer[py * view.w + px] = SUB_COL;
                    }
                  }
                }
              }
              b = b - 128;
            }
            b = b * 2;
          }
        }
      }
    }
  };
}
